# ===========================================
# AI Studio 部署环境变量示例
# ===========================================
# 复制此文件为 .env 后修改配置

# 数据库配置（Docker 部署时使用默认配置即可）
DB_NAME=ai_studio
DB_USER=postgres
DB_PASSWORD=postgres123
DB_PORT=5432

# Neo4j 图数据库密码
NEO4J_PASSWORD=neo4j123

# API 密钥（必须配置）
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 定时任务配置（可选）
SCHEDULED_URL_TIMEOUT_SECONDS=180
SCHEDULED_PAGE_TIMEOUT_SECONDS=60
SCHEDULED_MAX_ARTICLES=10
CRAWL_PAGE_TIMEOUT_MS=180000